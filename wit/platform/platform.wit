package sleeve:platform@0.1.0;

interface audit {
  log: func(event: string);
}

interface settings {
  request-body-limit: func() -> u64;
  allowed-origins: func() -> list<string>;
}

interface lifecycle {
  start: func(invocation: string);
  end: func(invocation: string, trapped: bool);
}

interface anchor {
  run: async func() -> u32;
  stop: async func();
}
